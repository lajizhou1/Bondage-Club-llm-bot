# ---- Bondage Club 账号（必填）----
BC_USERNAME=
BC_PASSWORD=

# ---- 服务器地址（默认值照搬即可）----
BC_SERVER_URL=https://bondage-club-server.herokuapp.com/
BC_ORIGIN=https://www.bondage-europe.com

# 可选：连接游戏服务器走的 HTTP 代理（例：本地 Clash 混合端口 7890/10086）
BC_PROXY_URL=

# 可选：登录后自动进指定房间（按房名精确匹配）。留空 = 自动搜索当前空间内人数最多
# 且未满的房间进入。
BC_ROOM_NAME=

# 搜索房间所在的空间：留空 = 女区 / "X" = 混区 / "M" = 男区
BC_ROOM_SPACE=X

# ---- BOT 身份与行为 ----
# BOT_NAME：用于 @ 提及检测的展示名。留空则用 BC 登录账号昵称。
BOT_NAME=
# 一对一服务对象：填注册号（数字）最稳定，也可填昵称。留空则不开启一对一。
SERVE_MEMBER=
# 安全词：服务对象说出这个词 = 真正拒绝（立即停止并安抚）。不含安全词的拒绝话
# （如"不要/停"）视为 RP 剧情。可逗号分隔多个。
SAFE_WORD=
# NSFW 尺度档位：0=含蓄 1=中度 2=直白（服务对象在聊天里说"尺度含蓄/中度/直白"可随时切换）
NSFW_LEVEL=0
# 锁紧度：上锁时把 Item.Difficulty + Property.Difficulty 拉到该值（防挣脱；过高可能被接收端截断）
LOCK_DIFFICULTY=50
# BOT 人设提示词：描述 BOT 性格 / 说话风格 / 与服务对象的关系，决定 LLM 输出基调
BOT_PERSONA=You are a friendly and witty club regular. Stay in character and keep replies short and natural.
# 是否响应所有玩家（true=房间内所有消息都过 LLM，false=只响应服务对象+被 @ 的玩家）
RESPOND_TO_ALL=false
# 同一玩家两条消息的最小响应间隔（毫秒，默认 1500=1.5 秒），防刷屏
RESPONSE_COOLDOWN_MS=1500
# 单条回复最大字符数（默认 400），超出部分会被截断
MAX_REPLY_LENGTH=400

# ---- LLM（任何兼容 OpenAI 接口的服务都行）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- #16 限时回家游戏（Go-Home game）----
# 总开关（false = 服务对象说口令也不开局）
GOHOME_ENABLED=true
# 限时上限（分钟，默认 15）：实际每局限时 = 战绩基线（无连胜 15 / 连胜 1/2/3+ 局 → 12/10/8）
# + LLM 按她当下态度 ±3 分钟微调，最终落在 [GOHOME_TIME_MIN_FLOOR, GOHOME_TIME_LIMIT_MIN] 内
GOHOME_TIME_LIMIT_MIN=15
# 限时下限（分钟，默认 5）：低于此值她挂牌即超时，游戏失去意义
GOHOME_TIME_MIN_FLOOR=5
# 目标热闹房最少人数（同时要求房间未禁止牵绳，超时才牵得回来）
GOHOME_MIN_PLAYERS=4
# 换房找热闹房最多尝试间数：每间听 15 秒（<2 人发言算冷清）就换没去过的下一间；
# 全都冷清（深夜常态）→ 兜底去人数最多的房挂标牌。去过的房搜索期不再重进
GOHOME_ROOM_ATTEMPTS=5
# 讲完规则等她点头的窗口（分钟）：点头才开始上束缚；超时不点头=作废，重喊口令即可再开
GOHOME_CONSENT_TIMEOUT_MIN=3
# 跨区局（本局选了与家不同区）时，好友 Beep 叫她自己走过来后最多等多少秒（默认 180）
GOHOME_FOLLOW_TIMEOUT_SEC=180
# 跨区会合（09-06 新流程）：Beep 让她去目标区后，轮询在线好友定位她所在房间的
# 总窗口秒数（默认 120）与轮询间隔秒数（默认 10）。窗口内没等到她=作废
GOHOME_REUNION_TIMEOUT_SEC=120
GOHOME_REUNION_POLL_SEC=10
# 宠物标牌上写的求助文字（最多 14 字符，会自动对半拆成两行；上锁后不可改）
GOHOME_TAG_TEXT=白给大王
# BOT 道具互动白名单追加（逗号分隔注册号）。BOT 的互动权限设为"仅白名单"，
# 名单默认含服务对象（SERVE_MEMBER）；这里可追加其他人（如你自己的小号）。留空=只有服务对象
BOT_ITEM_WHITELIST=
# BOT 道具互动权限档位（BC 官方设置同款语义）：
#   0=所有人（黑名单都不拦） 1=公开·黑名单除外 2=支配者+白名单+恋人（黑名单除外）
#   3=仅白名单+恋人（默认，防路人乱动穿戴） 4=仅恋人
# 设为 1 即"公开（黑名单除外）"——所有人可对 BOT 使用道具，只有黑名单被服务器拦截
BOT_ITEM_PERMISSION=3

# #60 启动重穿总开关：默认 true——首次进房自动按存档恢复（防路人乱穿后的自愈）
# 设为 false 则**完全跳过**存档重穿，保留玩家手动穿好的外观（适合用官方客户端
# 亲手给 BOT 穿好衣服后启动 BOT 的场景）。白名单权限照常生效，防别人继续动 BOT 穿戴。
BOT_OUTFIT_ON_STARTUP=true

# #62 每次进房自动摆的姿势（默认 LegsClosed=双腿并拢站好；留空=不摆）
# 可选：StandUp(正常站立)/Kneel(跪下)/KneelingSpread(跪着张腿)/Yoked(双臂平展)/
#       OverTheHead(举手)/BackBoxTie(后手盒式)/BackCuffs(背后铐式)/LegsClosed(并腿站好)/AllFours(四肢着地)
# 只在进房瞬间设一次；之后服务对象仍可用口令让 BOT 换姿势。
BOT_JOIN_POSE=LegsClosed

# ---- #63 主动/被动模式 ----
# 总开关：false = 永远纯被动（现状，只响应不主动）。默认开
PROACTIVE_ENABLED=true
# 开窗后窗口时长（分钟，默认 30）：窗口内 BOT 每 PROACTIVE_PERCEIVE_SEC 秒感知一次，
# 可自主决定说话/动作/沉默；到期或连续 PROACTIVE_IDLE_CLOSE 次无事可做 → 自动回落被动。
# 开窗信号：她求关注（无聊/陪我/在吗…）、LLM 判定求关注、游戏进行中、怒气恼火以上
PROACTIVE_WINDOW_MIN=30
# 窗口内定时感知间隔（秒，默认 240=4 分钟；她进房另会即时触发一次）
PROACTIVE_PERCEIVE_SEC=240
# 冷场门槛（秒，默认 180）：距她上次发言不足此值时感知直接跳过（刚被响应接待过，不重复
# 插话）。游戏进行中自动放宽为 60 秒（回合游戏需要推进）
PROACTIVE_SILENCE_MIN_SEC=180
# 两次主动行动的最小间隔（秒，默认 150）——防刷屏硬上限，与最近一次被动回复共用
PROACTIVE_MIN_GAP_SEC=150
# 连续 idle（LLM 选择沉默）达到此次数 → 提前关窗（没事可做就不硬撑）
PROACTIVE_IDLE_CLOSE=3

# ---- #64 集中/扩散模式 ----
# 集中（默认常态）= 一对一：只必响应服务对象，其他人被 @ 才礼貌回应；
# 扩散（社交模式）= 房内所有消息都过 LLM，BOT 能跟路人互动（Dom 式礼貌有距离、
# 如实承认 bot 身份、不与路人调情、束缚动作只对服务对象）。
# 开启信号：①服务对象口令"社交开/关" ②限时回家挂牌期间自动 ③LLM 感知她在跟
# 其他玩家互动（10 分钟窗口自动回落）。SOCIAL_ENABLED=false 关闭整个功能。
SOCIAL_ENABLED=true

# 思考强度 low/high/max（仅思考模式生效；留空/不设 = API 默认 high）
# LLM_REASONING_EFFORT=

# ---- #16 胜负奖惩 ----
# 失败基础锁分钟数
GOHOME_PUNISH_BASE_MIN=15
# 认输/作弊的额外锁 = 游戏剩余分钟 x 倍数
GOHOME_PUNISH_REMAIN_MULT=2
# 作弊（戴牌回家/挣脱拆牌）加怒气值
GOHOME_CHEAT_ANGER=35
# 赢家亲密度加成
GOHOME_WIN_INTIMACY=5

# 采样参数按区分（2026-09-05 用户需求：混区房多需更密集采样）
# 搜索期间每间停留观察的秒数（女区节奏慢、混区节奏快）
GOHOME_SAMPLE_SEC_FEMALE=30
GOHOME_SAMPLE_SEC_MIXED=15
# 最多尝试的房间数（混区房多可以多试几间）
GOHOME_ROOM_ATTEMPTS_FEMALE=5
GOHOME_ROOM_ATTEMPTS_MIXED=10
